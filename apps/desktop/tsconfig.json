{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // The window's code, the unit tests beside it and the browser tests over it all run in
    // (or drive) a browser, so they share one project rather than three that could drift.
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node"]
  },
  "include": ["src", "e2e", "vite.config.ts", "playwright.config.ts"]
}
