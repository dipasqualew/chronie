{
  "name": "chronie",
  "private": true,
  "packageManager": "bun@1.3.13",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/desktop tauri dev",
    "build": "bun run --cwd apps/desktop tauri build",
    "install-locally": "bun run scripts/install-locally.ts",
    "render": "bun run scripts/render-model.ts",
    "trace": "bun run scripts/trace-render.ts",
    "bindings:generate": "CHRONIE_WRITE_BINDINGS=1 cargo test --manifest-path apps/desktop/src-tauri/Cargo.toml the_committed_bindings_match_the_commands",
    "tables:generate": "bun run scripts/make-game-tables.ts",
    "test": "bun run --cwd apps/desktop test",
    "test:e2e": "bun run --cwd apps/desktop test:e2e",
    "test:scripts": "node node_modules/vitest/vitest.mjs run",
    "test:fixtures": "bun run scripts/check-fixtures.ts",
    "typecheck": "tsc -p apps/desktop && tsc -p scripts",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx}\"",
    "ci:wait": "bun run scripts/wait-for-ci.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.54.2",
    "@types/node": "^22.15.3",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.8.0",
    "jiti": "2.7.0",
    "prettier": "3.9.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "8.65.0",
    "vitest": "^3.2.4"
  }
}
