{
  // Shared by the desktop frontend and the repository's own scripts. Nothing is ever emitted
  // from here: Vite, Vitest and Bun each strip the types themselves, so `tsc` is only ever
  // asked the one question `./scripts/check.sh` cares about — does this all still add up.
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true
  }
}
